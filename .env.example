# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/smms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smms

# Security
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seed
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@smms.local
ADMIN_PASSWORD=change-me-in-production

# CORS
ALLOWED_HOSTS=http://localhost,http://localhost:3000

# Cloudinary (optional; image uploads fall back to URL if not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Frontend
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=
